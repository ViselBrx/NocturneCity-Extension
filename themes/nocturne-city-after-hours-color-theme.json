  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#AA92A4"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "string.unquoted.heredoc"
      ],
      "settings": {
        "foreground": "#B8C994"
      }
    },
    {
      "name": "String escapes and interpolation",
      "scope": [
        "constant.character.escape",
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#9ACFC8"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#E3BC88"
      }
    },
    {
      "name": "Constants and language values",
      "scope": [
        "constant.language",
        "constant.other",
        "variable.language",
        "variable.other.constant",
        "support.constant"
      ],
      "settings": {
        "foreground": "#E9A3A6"
      }
    },
    {
      "name": "Keywords and declarations",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#D8A3CD"
      }
    },
    {
      "name": "Types, classes and namespaces",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#9ACFC8"
      }
    },
    {
      "name": "Functions and methods",
      "scope": [
        "entity.name.function",
        "entity.name.method",
        "support.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#B3B4EB"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#DDC5B7"
      }
    },
    {
      "name": "Properties and object keys",
      "scope": [
        "variable.other.property",
        "variable.object.property",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#E8D6E2"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#C7ACD9"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#B8A1B3"
      }
    },
    {
      "name": "HTML and JSX tags",
      "scope": [
        "entity.name.tag",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#D8A3CD"
      }
    },
    {
      "name": "HTML and JSX attributes",
      "scope": [
        "entity.other.attribute-name.html",
        "entity.other.attribute-name.jsx",
        "entity.other.attribute-name.tsx",
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#B3B4EB"
      }
    },
    {
      "name": "CSS selectors",
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "entity.name.tag.css"
      ],
      "settings": {
        "foreground": "#D8A3CD"
      }
    },
    {
      "name": "CSS properties",
      "scope": [
        "support.type.property-name.css",
        "support.type.vendored.property-name.css",
        "meta.property-name.css"
      ],
      "settings": {
        "foreground": "#9ACFC8"
      }
    },
    {
      "name": "CSS values",
      "scope": [
        "support.constant.property-value.css",
        "support.constant.color.w3c-standard-color-name.css",
        "support.constant.color.w3c-extended-color-name.css",
        "support.constant.color.current.css",
        "support.constant.vendored.property-value.css",
        "constant.other.color.rgb-value.hex.css",
        "constant.numeric.css",
        "keyword.other.unit.css"
      ],
      "settings": {
        "foreground": "#B8C994"
      }
    },
    {
      "name": "JSON keys",
      "scope": [
        "support.type.property-name.json",
        "meta.structure.dictionary.key.json"
      ],
      "settings": {
        "foreground": "#B3B4EB"
      }
    },
    {
      "name": "Python decorators",
      "scope": [
        "entity.name.function.decorator.python",
        "punctuation.definition.decorator.python"
      ],
      "settings": {
        "foreground": "#C7ACD9"
      }
    },
    {
      "name": "SQL identifiers",
      "scope": [
        "constant.other.table-name.sql",
        "constant.other.database-name.sql"
      ],
      "settings": {
        "foreground": "#9ACFC8"
      }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#D8A3CD",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown links",
      "scope": [
        "markup.underline.link",
        "string.other.link",
        "markup.underline.link.image"
      ],
      "settings": {
        "foreground": "#9ACFC8"
      }
    },
    {
      "name": "Markdown emphasis",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#DDC5B7",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown strong",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#E3BC88",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Invalid syntax",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#EE939F"
      }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "namespace": "#9ACFC8",
    "type": "#9ACFC8",
    "typeParameter": "#9ACFC8",
    "class": "#9ACFC8",
    "interface": "#9ACFC8",
    "struct": "#9ACFC8",
    "enum": "#9ACFC8",
    "enumMember": "#E9A3A6",
    "function": "#B3B4EB",
    "method": "#B3B4EB",
    "macro": "#B3B4EB",
    "parameter": "#DDC5B7",
    "property": "#E8D6E2",
    "variable": "#E8D6E2",
    "variable.readonly": "#E9A3A6",
    "property.readonly": "#E9A3A6",
    "string": "#B8C994",
    "number": "#E3BC88",
    "regexp": "#9ACFC8",
    "keyword": "#D8A3CD",
    "operator": "#C7ACD9",
    "comment": "#AA92A4",
    "decorator": "#C7ACD9"
  }
}
