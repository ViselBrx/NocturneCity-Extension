  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#96A6AA"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "string.unquoted.heredoc"
      ],
      "settings": {
        "foreground": "#B5C995"
      }
    },
    {
      "name": "String escapes and interpolation",
      "scope": [
        "constant.character.escape",
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#C1F3E8"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#E5B76D"
      }
    },
    {
      "name": "Constants and language values",
      "scope": [
        "constant.language",
        "constant.other",
        "variable.language",
        "variable.other.constant",
        "support.constant"
      ],
      "settings": {
        "foreground": "#E19A78"
      }
    },
    {
      "name": "Keywords and declarations",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#B9AEDF"
      }
    },
    {
      "name": "Types, classes and namespaces",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#7DCBD1"
      }
    },
    {
      "name": "Functions and methods",
      "scope": [
        "entity.name.function",
        "entity.name.method",
        "support.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#9CBAEF"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#C4CFD2"
      }
    },
    {
      "name": "Properties and object keys",
      "scope": [
        "variable.other.property",
        "variable.object.property",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#C4CFD2"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#B4C3CB"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#96A6AA"
      }
    },
    {
      "name": "HTML and JSX tags",
      "scope": [
        "entity.name.tag",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#B9AEDF"
      }
    },
    {
      "name": "HTML and JSX attributes",
      "scope": [
        "entity.other.attribute-name.html",
        "entity.other.attribute-name.jsx",
        "entity.other.attribute-name.tsx",
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#9CBAEF"
      }
    },
    {
      "name": "CSS selectors",
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "entity.name.tag.css"
      ],
      "settings": {
        "foreground": "#B9AEDF"
      }
    },
    {
      "name": "CSS properties",
      "scope": [
        "support.type.property-name.css",
        "support.type.vendored.property-name.css",
        "meta.property-name.css"
      ],
      "settings": {
        "foreground": "#7DCBD1"
      }
    },
    {
      "name": "CSS values",
      "scope": [
        "support.constant.property-value.css",
        "support.constant.color.w3c-standard-color-name.css",
        "support.constant.color.w3c-extended-color-name.css",
        "support.constant.color.current.css",
        "support.constant.vendored.property-value.css",
        "constant.other.color.rgb-value.hex.css",
        "constant.numeric.css",
        "keyword.other.unit.css"
      ],
      "settings": {
        "foreground": "#B5C995"
      }
    },
    {
      "name": "JSON keys",
      "scope": [
        "support.type.property-name.json",
        "meta.structure.dictionary.key.json"
      ],
      "settings": {
        "foreground": "#9CBAEF"
      }
    },
    {
      "name": "Python decorators",
      "scope": [
        "entity.name.function.decorator.python",
        "punctuation.definition.decorator.python"
      ],
      "settings": {
        "foreground": "#B4C3CB"
      }
    },
    {
      "name": "SQL identifiers",
      "scope": [
        "constant.other.table-name.sql",
        "constant.other.database-name.sql"
      ],
      "settings": {
        "foreground": "#7DCBD1"
      }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#B9AEDF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown links",
      "scope": [
        "markup.underline.link",
        "string.other.link",
        "markup.underline.link.image"
      ],
      "settings": {
        "foreground": "#7DCBD1"
      }
    },
    {
      "name": "Markdown emphasis",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#C4CFD2",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown strong",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#E5B76D",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Invalid syntax",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#EA8790"
      }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "namespace": "#7DCBD1",
    "type": "#7DCBD1",
    "typeParameter": "#7DCBD1",
    "class": "#7DCBD1",
    "interface": "#7DCBD1",
    "struct": "#7DCBD1",
    "enum": "#7DCBD1",
    "enumMember": "#E19A78",
    "function": "#9CBAEF",
    "method": "#9CBAEF",
    "macro": "#9CBAEF",
    "parameter": "#C4CFD2",
    "property": "#D7E1E3",
    "variable": "#D7E1E3",
    "variable.readonly": "#E19A78",
    "property.readonly": "#E19A78",
    "string": "#B5C995",
    "number": "#E5B76D",
    "regexp": "#C1F3E8",
    "keyword": "#B9AEDF",
    "operator": "#B4C3CB",
    "comment": "#96A6AA",
    "decorator": "#B4C3CB"
  }
}
