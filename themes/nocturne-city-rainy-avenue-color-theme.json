  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#8FA4B9"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "string.unquoted.heredoc"
      ],
      "settings": {
        "foreground": "#A6C99C"
      }
    },
    {
      "name": "String escapes and interpolation",
      "scope": [
        "constant.character.escape",
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#82CDDA"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#DDBB8C"
      }
    },
    {
      "name": "Constants and language values",
      "scope": [
        "constant.language",
        "constant.other",
        "variable.language",
        "variable.other.constant",
        "support.constant"
      ],
      "settings": {
        "foreground": "#E1A7A1"
      }
    },
    {
      "name": "Keywords and declarations",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#B6B0E6"
      }
    },
    {
      "name": "Types, classes and namespaces",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#82CDDA"
      }
    },
    {
      "name": "Functions and methods",
      "scope": [
        "entity.name.function",
        "entity.name.method",
        "support.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#90B6EF"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#C7CBD4"
      }
    },
    {
      "name": "Properties and object keys",
      "scope": [
        "variable.other.property",
        "variable.object.property",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#D2DFED"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#A8BBD9"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#9AADC1"
      }
    },
    {
      "name": "HTML and JSX tags",
      "scope": [
        "entity.name.tag",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#B6B0E6"
      }
    },
    {
      "name": "HTML and JSX attributes",
      "scope": [
        "entity.other.attribute-name.html",
        "entity.other.attribute-name.jsx",
        "entity.other.attribute-name.tsx",
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#90B6EF"
      }
    },
    {
      "name": "CSS selectors",
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "entity.name.tag.css"
      ],
      "settings": {
        "foreground": "#B6B0E6"
      }
    },
    {
      "name": "CSS properties",
      "scope": [
        "support.type.property-name.css",
        "support.type.vendored.property-name.css",
        "meta.property-name.css"
      ],
      "settings": {
        "foreground": "#82CDDA"
      }
    },
    {
      "name": "CSS values",
      "scope": [
        "support.constant.property-value.css",
        "support.constant.color.w3c-standard-color-name.css",
        "support.constant.color.w3c-extended-color-name.css",
        "support.constant.color.current.css",
        "support.constant.vendored.property-value.css",
        "constant.other.color.rgb-value.hex.css",
        "constant.numeric.css",
        "keyword.other.unit.css"
      ],
      "settings": {
        "foreground": "#A6C99C"
      }
    },
    {
      "name": "JSON keys",
      "scope": [
        "support.type.property-name.json",
        "meta.structure.dictionary.key.json"
      ],
      "settings": {
        "foreground": "#90B6EF"
      }
    },
    {
      "name": "Python decorators",
      "scope": [
        "entity.name.function.decorator.python",
        "punctuation.definition.decorator.python"
      ],
      "settings": {
        "foreground": "#A8BBD9"
      }
    },
    {
      "name": "SQL identifiers",
      "scope": [
        "constant.other.table-name.sql",
        "constant.other.database-name.sql"
      ],
      "settings": {
        "foreground": "#82CDDA"
      }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#B6B0E6",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown links",
      "scope": [
        "markup.underline.link",
        "string.other.link",
        "markup.underline.link.image"
      ],
      "settings": {
        "foreground": "#82CDDA"
      }
    },
    {
      "name": "Markdown emphasis",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#C7CBD4",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown strong",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#DDBB8C",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Invalid syntax",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#E996A4"
      }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "namespace": "#82CDDA",
    "type": "#82CDDA",
    "typeParameter": "#82CDDA",
    "class": "#82CDDA",
    "interface": "#82CDDA",
    "struct": "#82CDDA",
    "enum": "#82CDDA",
    "enumMember": "#E1A7A1",
    "function": "#90B6EF",
    "method": "#90B6EF",
    "macro": "#90B6EF",
    "parameter": "#C7CBD4",
    "property": "#D2DFED",
    "variable": "#D2DFED",
    "variable.readonly": "#E1A7A1",
    "property.readonly": "#E1A7A1",
    "string": "#A6C99C",
    "number": "#DDBB8C",
    "regexp": "#82CDDA",
    "keyword": "#B6B0E6",
    "operator": "#A8BBD9",
    "comment": "#8FA4B9",
    "decorator": "#A8BBD9"
  }
}
